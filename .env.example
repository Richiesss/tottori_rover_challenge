# このファイルを .env にコピーして、自分の環境に合わせて編集する
#   cp .env.example .env

# --- 使う環境を1つ選ぶ ---
# WSL2 (Windows 11):
COMPOSE_FILE=compose.yaml:compose.wsl.yaml
# ネイティブUbuntu:
# COMPOSE_FILE=compose.yaml:compose.linux.yaml

# ホストの `id -u` / `id -g` の値（多くの場合 1000）
USER_UID=1000
USER_GID=1000

TURTLEBOT3_MODEL=burger
# 同じLAN内で他の人と通信が混ざる場合は 0〜101 の範囲で人ごとに変える
ROS_DOMAIN_ID=0
