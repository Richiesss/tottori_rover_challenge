# このファイルを .env にコピーして、自分の環境に合わせて編集する
#   cp .env.example .env

# --- 使う環境を1つ選ぶ ---
# WSL2 (Windows 11):
COMPOSE_FILE=compose.yaml:compose.wsl.yaml
# ネイティブUbuntu:
# COMPOSE_FILE=compose.yaml:compose.linux.yaml
# WSL2でGPU(D3D12/EGL)初期化に失敗する場合は、末尾に :compose.software-render.yaml を追加して
# ソフトウェアレンダリングにする（LIBGL_ALWAYS_SOFTWARE / GALLIUM_DRIVER の設定も必要。トラブルシューティング参照）

# ホストの `id -u` / `id -g` の値（多くの場合 1000）
USER_UID=1000
USER_GID=1000

# `getent group render` で確認したホストのrenderグループGID（GPU(/dev/dri)アクセス用。多くの場合 992 や 109 など）
RENDER_GID=992

TURTLEBOT3_MODEL=burger
# 同じLAN内で他の人と通信が混ざる場合は 0〜101 の範囲で人ごとに変える
ROS_DOMAIN_ID=0
